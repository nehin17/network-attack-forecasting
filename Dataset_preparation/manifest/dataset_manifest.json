    "VALIDATION": {
      "samples": 398,
      "X_shape": [
        398,
        15,
        80
      ],
      "y_shape": [
        398,
        5
      ]
    },
    "TEST": {
      "samples": 396,
      "X_shape": [
        396,
        15,
        80
      ],
      "y_shape": [
        396,
        5
      ]
    }
  },
  "preprocessing": {
    "scaler": "StandardScaler",
